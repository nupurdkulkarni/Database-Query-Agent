# ============================================================================
# LLM Model Configuration
# ============================================================================

# 1. INTENT ANALYSIS (The Router)
# Task: Decides if the query is data, metadata, or general chat.
# Recommended: Fast, cheap model (gpt-4o-mini).
INTENT_MODEL=gpt-4o-mini

# 2. SQL GENERATION (The Brain)
# Task: Drafts and repairs PostgreSQL queries.
# Recommended: Reliable reasoning model (gpt-4o-mini or gpt-4o).
SQL_MODEL=gpt-4o-mini

# 3. SUMMARIZATION (The Voice)
# Task: Provides natural language answers and insights.
# Recommended: Conversational model (Llama 3.1/3.3 or GPT-4o-mini).
SUMMARY_MODEL=meta-llama/llama-3.1-8b-instruct
SUMMARY_LLM_TEMPERATURE=0.1

# ============================================================================
# API Keys & Connections
# ============================================================================
OPENAI_API_KEY=your_openai_key_here
SUMMARY_LLM_API_KEY=your_summary_key_here (OpenRouter or OpenAI)
DB_URL=postgresql://user:pass@host:port/dbname
